{
  "expo": {
    "name": "befit",
    "slug": "befit",
    "description": "A Product By OneRed",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/applogo.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#1A1735"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pfndesign.befit",
      "infoPlist": {
        "NSHealthShareUsageDescription": "BeFit usa tus datos de Salud (pasos, ritmo cardíaco, sueño) para mostrarte tu progreso real.",
        "NSHealthUpdateUsageDescription": "BeFit puede registrar entrenamientos y métricas en tu app de Salud."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/applogo.png",
        "backgroundColor": "#1A1735"
      },
      "package": "com.pfndesign.befit",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.WRITE_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.WRITE_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.WRITE_SLEEP",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.WRITE_HYDRATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "apiBaseUrl": "https://testapp.bestronger.es/api"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#1A1735"
        }
      ],
      [
        "react-native-share",
        {
          "ios": [
            "instagram-stories",
            "instagram"
          ],
          "android": [
            "com.instagram.android"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permite a BeFit guardar la imagen de tu resumen de entrenamiento en tu galería.",
          "savePhotosPermission": "Permite a BeFit guardar la imagen de tu resumen de entrenamiento en tu galería."
        }
      ],
      "@kingstinct/react-native-healthkit",
      "react-native-health-connect"
    ]
  }
}
