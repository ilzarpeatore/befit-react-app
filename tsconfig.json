{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "types": ["node", "jest"],
    "paths": {
      "@components/*": ["./components/*"],
      "@pages/*": ["./pages/*"],
      "@assets/*": ["./assets/*"],
      "@constants/*": ["./constants/*"],
      "@helper/*": ["./helper/*"],
      "@store/*": ["./store/*"],
      "@api/*": ["./api/*"],
      "@hooks/*": ["./hooks/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"]
}
